<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="spareParts.App">
    <Application.Resources>
        <ResourceDictionary>
            <Style TargetType="TabBar">
                <Setter Property="Shell.TabBarBackgroundColor" Value="#121B2B" />
                <Setter Property="Shell.TabBarTitleColor" Value="Transparent" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="#8A92A6" />
                <Setter Property="Shell.TabBarForegroundColor" Value="#F35D07" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
