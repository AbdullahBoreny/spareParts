<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="spareParts.PageViews.Customer.ChatPage"
             xmlns:helpers="clr-namespace:spareParts.Helpers"
             Title="{Binding shopName}">
             
    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:IncomingToAlignConverter x:Key="IncomingToAlignConverter" />
            <helpers:IncomingToColorConverter x:Key="IncomingToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>


    <Grid RowDefinitions="*, Auto" Margin="10">
        
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Messages}"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5" ColumnDefinitions="*, Auto" RowDefinitions="Auto">
                        <Frame CornerRadius="15"
                               Padding="12,8"
                               HasShadow="False"
                               BackgroundColor="{Binding IsIncoming, Converter={StaticResource IncomingToColorConverter}}"
                               HorizontalOptions="{Binding IsIncoming, Converter={StaticResource IncomingToAlignConverter}}">
                            <VerticalStackLayout>
                                <Label Text="{Binding MessageContent}" TextColor="White" />
                                <Label Text="{Binding MessageCreationDate}" FontSize="10" HorizontalOptions="End" TextColor="#DDD" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="10" Padding="0,10">
            <Entry Grid.Column="0" 
                   Text="{Binding NewMessageText}" 
                   Placeholder="Type a message..."
                   VerticalOptions="Center" />
            
            <Button Grid.Column="1" 
                    Text="Send" 
                    Command="{Binding SendCommand}"
                    CornerRadius="25"
                    HeightRequest="50"
                    WidthRequest="80" />
        </Grid>
    </Grid>
</ContentPage>