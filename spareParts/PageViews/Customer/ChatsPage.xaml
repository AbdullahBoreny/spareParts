<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="spareParts.PageViews.Customer.ChatsPage"
             xmlns:viewmodels="clr-namespace:spareParts.ViewModels.Customer"
             BackgroundColor="#121B2B"
             Title="Messages">

    <Grid RowDefinitions="Auto, *">
        
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="15">
            <Label Text="MESSAGES" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   CharacterSpacing="1"/>
            
            <Border BackgroundColor="#1E2738" 
                    Stroke="#2A3547" 
                    StrokeShape="RoundRectangle 12" 
                    Padding="15,0">
                <Grid ColumnDefinitions="Auto, *">
                    <Image Source="search_icon.png" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" 
                           Placeholder="Search chats..." 
                           PlaceholderColor="#8A92A6" 
                           TextColor="White"
                           FontSize="14"
                           Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding ChatList}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="20,10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ChatsViewModel}}, Path=BindingContext.OpenChatCommand}" 
                                                  CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="60, *, Auto" ColumnSpacing="15">
                            <Grid Grid.Column="0">
                                <Ellipse Fill="#00FF7F" 
                                         HeightRequest="12" 
                                         WidthRequest="12" 
                                         HorizontalOptions="End" 
                                         VerticalOptions="End" 
                                         Stroke="Black" 
                                         StrokeThickness="2"
                                         IsVisible="{Binding IsOnline}"/>
                            </Grid>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding ShopName}" 
                                       TextColor="White" 
                                       FontSize="16" 
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding LastMessage}" 
                                       TextColor="#8A92A6" 
                                       FontSize="13" 
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="5">
                                <Label Text="{Binding Time}" 
                                       TextColor="#8A92A6" 
                                       FontSize="11"/>
                                <Border BackgroundColor="#F35D07" 
                                        StrokeShape="RoundRectangle 10" 
                                        HeightRequest="20" 
                                        WidthRequest="20" 
                                        IsVisible="{Binding UnreadCount, Converter={StaticResource IntToBoolConverter}}">
                                    <Label Text="{Binding UnreadCount}" 
                                           TextColor="White" 
                                           FontSize="10" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           FontAttributes="Bold"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        
                        <BoxView HeightRequest="0.5" 
                                 BackgroundColor="#2A3547" 
                                 VerticalOptions="End" 
                                 Margin="75,10,0,0"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>