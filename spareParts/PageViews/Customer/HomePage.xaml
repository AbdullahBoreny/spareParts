<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:spareParts.Converters"
             xmlns:viewmodels="clr-namespace:spareParts.ViewModels.Customer"
             xmlns:models="clr-namespace:spareParts.Models"
             x:Class="spareParts.PageViews.Customer.HomePage"
             BackgroundColor="#121B2B"
             Title="Home">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter" />
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="20">
            
            <VerticalStackLayout Spacing="5" Margin="0,30,0,10">
                <Image Source="wrench_icon.png" 
                       HeightRequest="80" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,10"/>
                
                <Label Text="SPARE PARTS" 
                       FontSize="28" 
                       FontAttributes="Bold" 
                       CharacterSpacing="2"
                       HorizontalOptions="Center" 
                       TextColor="White" />
                
                <Label Text="Find quality parts for your needs" 
                       FontSize="14" 
                       HorizontalOptions="Center" 
                       TextColor="#8A92A6" />
            </VerticalStackLayout>
            
            <StackLayout x:Name="UserInfoSection" IsVisible="True">
                <Border BackgroundColor="#1E2738" 
                        Stroke="#2A3547"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 15" 
                        Padding="20">
                    <VerticalStackLayout>
                        <Label x:Name="WelcomeLabel"
                               Text="WELCOME BACK" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="#F35D07" 
                               CharacterSpacing="1"/>
                        <Label x:Name="EmailLabel"
                               Text="{Binding WelcomeMessage}" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>
            </StackLayout>
            
            <StackLayout x:Name="ShopsSection" IsVisible="True">
                <Label Text="AVAILABLE SHOPS" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       CharacterSpacing="1"
                       Margin="5,0,0,15" />
                
                <CollectionView x:Name="ShopsCollection" ItemsSource="{Binding Shops}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,0,0,20">
                                <Border BackgroundColor="#1E2738"
                                        Stroke="#2A3547"
                                        StrokeShape="RoundRectangle 15" 
                                        Padding="0">
                                    <VerticalStackLayout>
                                        
                                        <Grid Padding="15" BackgroundColor="#252F42">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding Name}" 
                                                       FontSize="18" 
                                                       FontAttributes="Bold" 
                                                       TextColor="White" />
                                                <Label Text="{Binding Address}" 
                                                       FontSize="12" 
                                                       TextColor="#8A92A6" />
                                            </VerticalStackLayout>
                                            
                                            <Label Grid.Column="1" 
                                                   Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}" 
                                                   FontSize="11" 
                                                   TextColor="#F35D07" 
                                                   VerticalOptions="Center" 
                                                   FontAttributes="Bold"/>
                                        </Grid>
                                        
                                        <Grid Padding="15" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                                                <Label Text="{Binding ProductCount}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                <Label Text="Items" FontSize="11" TextColor="#8A92A6" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                            
                                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                                <Label Text="{Binding Rating}" TextColor="#F35D07" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                <Label Text="Rating" FontSize="11" TextColor="#8A92A6" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                            
                                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                                <Label Text="{Binding Distance}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                <Label Text="km" FontSize="11" TextColor="#8A92A6" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Button Text="View Shop" 
                                                BackgroundColor="#F35D07" 
                                                TextColor="White" 
                                                CornerRadius="10" 
                                                HeightRequest="45" 
                                                FontAttributes="Bold"
                                                Margin="15,0,15,15"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomeViewModel}}, Path=ViewShopCommand}"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>