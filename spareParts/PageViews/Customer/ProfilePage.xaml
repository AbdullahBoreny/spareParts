<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:spareParts.Converters"
             xmlns:services="clr-namespace:spareParts.Services"
             x:Class="spareParts.PageViews.Customer.ProfilePage"
             xmlns:viewmodels="clr-namespace:spareParts.ViewModels.Customer"
             BackgroundColor="#121B2B"
             Title="Profile">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="20">
            
            <VerticalStackLayout Spacing="20">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,10">
                    <Border Stroke="#F35D07"
                            StrokeThickness="2"
                            HeightRequest="100"
                            WidthRequest="100"
                            StrokeShape="RoundRectangle 50"
                            BackgroundColor="#1E2738"
                            HorizontalOptions="Center">
                        <Label Text="👤" FontSize="50" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>
                    <Label Text="{Binding CurrentUserName}" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding CurrentUserEmail}" 
                           FontSize="14" 
                           TextColor="#8A92A6"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Label Text="ACCOUNT SETTINGS" FontSize="12" FontAttributes="Bold" TextColor="#F35D07" CharacterSpacing="1" Margin="5,0,0,0"/>
                
                <Border BackgroundColor="#1E2738" 
                        Stroke="#2A3547"
                        StrokeShape="RoundRectangle 15" 
                        Padding="15">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Full Name" FontSize="12" TextColor="#8A92A6" Margin="5,0"/>
                            <Entry x:Name="NameEntry" TextColor="White" BackgroundColor="#121B2B" HeightRequest="45" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Phone Number" FontSize="12" TextColor="#8A92A6" Margin="5,0"/>
                            <Entry x:Name="PhoneEntry" TextColor="White" BackgroundColor="#121B2B" HeightRequest="45" Keyboard="Telephone" />
                        </VerticalStackLayout>
                        
                        <Button Text="SAVE CHANGES" 
                                BackgroundColor="#F35D07" 
                                TextColor="White" 
                                FontAttributes="Bold"
                                CornerRadius="10" 
                                HeightRequest="45"
                                Command="{Binding SaveCommand}"
                                Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="RECENT ORDERS" FontSize="12" FontAttributes="Bold" TextColor="#F35D07" CharacterSpacing="1" Margin="5,10,0,0"/>
                
                <Border BackgroundColor="#1E2738"
                        Stroke="#2A3547"
                        StrokeShape="RoundRectangle 15" 
                        Padding="5">
                    <CollectionView x:Name="OrdersCollection" HeightRequest="180">
                        <CollectionView.EmptyView>
                            <Label Text="No orders found" TextColor="#8A92A6" HorizontalOptions="Center" Margin="20"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding OrderNumber}" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{Binding OrderDate, StringFormat='{0:MMM dd, yyyy}'}" TextColor="#8A92A6" FontSize="12" />
                                    </VerticalStackLayout>
                                    
                                    <Label Grid.Column="1" 
                                           Text="{Binding Total, StringFormat='${0:F2}'}" 
                                           TextColor="#F35D07"
                                           FontAttributes="Bold" 
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
                
                <Button Text="LOG OUT" 
                        BackgroundColor="Transparent" 
                        TextColor="#E74C3C" 
                        BorderColor="#E74C3C"
                        BorderWidth="1"
                        CornerRadius="10" 
                        HeightRequest="50" 
                        Margin="0,10,0,30"
                        Command="{Binding LogoutCommand}"
                        x:Name="SignOutButton" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>