<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:spareParts.ViewModels.Authentication"
             Shell.FlyoutBehavior="Disabled"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False"
             x:Class="spareParts.PageViews.Authentication.SignupPage"
             x:DataType="viewmodels:SignupViewModel"
             Title="Sign Up">







       <ContentPage.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                     <GradientStop Color="#1A2A3A" Offset="0.1" />
                     <GradientStop Color="#0D151F" Offset="1.0" />
              </LinearGradientBrush>
       </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,60,30,30" VerticalOptions="Center">

            <Image Source="wrench_icon.png" 
                   HeightRequest="100" 
                   HorizontalOptions="Center" />
            
            <Label Text="Create Account"
                   TextColor="White"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   CharacterSpacing="2" />

            <Border StrokeShape="RoundRectangle 15"
                    StrokeThickness="1"
                    Stroke="#334455"
                    BackgroundColor="#22334499"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="5,5" Radius="10" Opacity="0.5" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" BackgroundColor="Transparent">
                        <Entry Placeholder="Full Name" 
                               PlaceholderColor="#8899AA"
                               Text="{Binding Name}"
                               TextColor="White"
                               HeightRequest="50"
                               Margin="10,0" />
                    </Border>

                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" BackgroundColor="Transparent">
                        <Entry Placeholder="Email Address" 
                               PlaceholderColor="#8899AA"
                               Text="{Binding Email}"
                               Keyboard="Email" 
                               TextColor="White"
                               HeightRequest="50"
                               Margin="10,0" />
                    </Border>

                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" BackgroundColor="Transparent">
                        <Entry Placeholder="Password" 
                               IsPassword="True"
                               Text="{Binding Password}"
                               PlaceholderColor="#8899AA"
                               TextColor="White"
                               HeightRequest="50"
                               Margin="10,0" />
                    </Border>

                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" BackgroundColor="Transparent">
                        <Entry Placeholder="Confirm Password" 
                               Text="{Binding ConfirmPassword}"
                               IsPassword="True"
                               PlaceholderColor="#8899AA"
                               TextColor="White"
                               HeightRequest="50"
                               Margin="10,0" />
                    </Border>

                    <Button Text="SIGN UP"
                            BackgroundColor="#E65100"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="55"
                            Margin="0,10,0,0"
                            Command="{Binding SignupCommand}" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="Already have an account?" TextColor="#BBCCDD" />
                <Label Text="Sign In" 
                       TextColor="#FF8800" 
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
